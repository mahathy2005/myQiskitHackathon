<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF6F9"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="♥"
            android:textColor="#E91E63"
            android:textSize="30sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-black"
            android:text="Add Trusted Contact"
            android:textColor="#E91E63"
            android:textSize="22sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Someone who can be there for you"
            android:textColor="#7A7893"
            android:textSize="12sp" />


        <!-- ===================================================== -->
        <!-- PRIVACY -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FCE4EC"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="🔒  Their details are stored privately for your safety"
                android:textColor="#8E24AA"
                android:textSize="10sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- FULL NAME -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="FULL NAME *"
            android:textColor="#2D2B52"
            android:textSize="11sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Enter full name"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_myplaces"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- RELATION -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="RELATION *"
            android:textColor="#2D2B52"
            android:textSize="11sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Select relationship"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <AutoCompleteTextView
                android:id="@+id/etGuardianRelation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- MOBILE -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MOBILE NUMBER *"
            android:textColor="#2D2B52"
            android:textSize="11sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="10-digit mobile number"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- BLOOD GROUP -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="BLOOD GROUP *"
            android:textColor="#2D2B52"
            android:textSize="11sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Select blood group"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <AutoCompleteTextView
                android:id="@+id/etGuardianBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- EMAIL -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="EMAIL • OPTIONAL"
            android:textColor="#2D2B52"
            android:textSize="11sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Email address"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- ADDRESS -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ADDRESS • OPTIONAL"
            android:textColor="#2D2B52"
            android:textSize="11sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Home or current address"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_mapmode"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress|textMultiLine"
                android:minLines="2"
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- BUTTONS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#8E24AA"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="#8E24AA"
                app:strokeWidth="1dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Save Contact"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#E91E63"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:text="♡  Your safety circle can include as many contacts as needed."
            android:textColor="#C2185B"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>